 {\n            this.s = s;\n            s.request(Long.MAX_VALUE);\n        }\n        public void onNext(String t) {\n            System.out.print(t);\n        }\n        public void onError(Throwable e) {\n            e.printStackTrace();\n        }\n        public void onComplete() {\n            System.out.println();\n        }\n    });\n\n    float[] vec = player.embed(messages); // length = model hidden dim (last RMS hidden before LM head)\n\n    // Optional OpenAI-compatible REST server on port 8080:\n    var api = player.startApiServer(8080);\n    Runtime.getRuntime().addShutdownHook(Thread.ofVirtual().unstarted(api::stop));\n}","position":{"start":{"line":47,"column":1},"end":{"line":90,"column":1}},"key":"eb5IbUyb8S"},{"type":"heading","depth":2,"position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"Programmatic LoRA (","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"WREFVd6ITQ"},{"type":"inlineCode","value":"LoraTrainer","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"HDRkeAYpuo"},{"type":"text","value":")","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"V6tcVUSf5N"}],"identifier":"programmatic-lora-loratrainer","label":"Programmatic LoRA (LoraTrainer)","html_id":"programmatic-lora-loratrainer","implicit":true,"key":"RwxM61E4kz"},{"type":"paragraph","position":{"start":{"line":94,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"text","value":"Same single-shard layout as ","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"HvTlewwRtp"},{"type":"inlineCode","value":"./juno lora","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"AJJ138dqgm"},{"type":"text","value":"; train from code then ","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"DAYgYw5xcl"},{"type":"inlineCode","value":"save()","position":{"start":