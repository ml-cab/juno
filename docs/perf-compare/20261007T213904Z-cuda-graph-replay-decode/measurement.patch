+package cab.ml.juno.node;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Locale;
+import java.util.Random;
+
+import org.junit.jupiter.api.AfterAll;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Decode-width microbenchmark: a real model's decode region, every layer run
+ * whole in one lease, with each layer's device work launched kernel by kernel
+ * ({@link ResidentQkvPath#run}) against the same work replayed from a captured
+ * CUDA graph ({@link ResidentQkvPath#runReplayed}). Both lanes upload the token's
+ * input once and download each layer's packed row as the region does.
+ *
+ * <p>The replayed lane holds the position fixed (a captured graph fixes every
+ * kernel argument), so it is the ceiling of what graph replay can save: a decode
+ * that wires it also pays to move the position, the mirror offset and the
+ * attention length every token. Before timing, one token is run both ways and
+ * every layer's k, v, attention output and layer output are compared bit for bit.
+ *
+ * <p>Runs only when {@value #MODELS_PROPERTY} names model files (comma-separated);
+ * a measurement, not a regression test. Options: {@code juno.graphReplay.pos}
+ * (default 512), {@code .tokens} per timed block (200), {@code .reps} (5),
+ * {@code .warmup} tokens per lane (100), {@code .out} (report path).
+ */
+@Tag("gpu")
+@DisplayName("decode layer: graph replay against launched kernels (measurement)")
+class DecodeLayerGraphReplayBench {
+
+	static final String MODELS_PROPERTY = "juno.graphReplay.models";
+
+	private static GpuContext ctx;
+
+	@BeforeAll
+	static void init() {
+		assumeTrue(System.getProperty(MODELS_PROPERTY) != null, "no models named in " + MODELS_PROPERTY);
+		assumeTrue(CudaAvailability.isAvailable(), "Skipping - no CUDA device");
+		assumeTrue(CudaDriverBindings.isAvailable(), "No CUDA driver API - skipping");
+		ctx = GpuContext.init(0);
+	}
+
+	@AfterAll
+	static void destroy() {
+		if (ctx != null)
+			ctx.close();
+	}
+
+	record Row(String model, int layers, int pos, double[] launchedMs, double[] replayedMs) {
+		double launched() {
+			return median(launchedMs);
+		}
+
+		double replayed() {
+			return median(replayedMs);
+		}
+	}
+
+	@Test
+	void graphReplayAgainstLaunchedLayers() throws Exception {
+		int pos = Integer.getInteger("juno.graphReplay.pos", 512);
+		int tokens = Integer.getInteger("juno.graphReplay.tokens", 200);
+		int reps = Integer.getInteger("juno.graphReplay.reps", 5);
+		int warmup = Integer.getInteger("juno.graphReplay.warmup", 100);
+		String saved = System.getProperty(GpuResidencyOptions.ENV_PROPERTY);
+		System.setProperty(GpuResidencyOptions.ENV_PROPERTY, "on");
+		List<Row> rows = new ArrayList<>();
+		try {
+			for (String m : System.getProperty(MODELS_PROPERTY).split(","))
+				rows.add(measure(Path.of(m.trim()), pos, tokens, reps, warmup));
+		} finally {
+			if (saved == null)
+				System.clearProperty(GpuResidencyOptions.ENV_PROPERTY);
+			else
+				System.setProperty(GpuResidencyOptions.ENV_PROPERTY, saved);
+		}
+		String report = report(rows, tokens, reps, warmup);
+		System.out.println(report);
+		String out = System.getProperty("juno.graphReplay.out");
+		if (out != null)
+			Files.writeString(Path.of(out), report);
+	}
+
+	private static Row measure(Path model, int pos, int tokens, int reps, int warmup) throws IOException {
+		LlamaConfig cfg;
+		try (GgufReader r = GgufReader.open(model)) {
+			cfg = LlamaConfig.from(r);
+		}
+		ShardContext shard = new ShardContext("n0", 0, cfg.numLayers(), true, true, cfg.vocabSize(), cfg.hiddenDim(),
+				cfg.numHeads());
+		CudaMatVec backend = new CudaMatVec(ctx);
+		LlamaTransformerHandler handler = LlamaTransformerHandler.load(model, shard, backend);
+		int layers = cfg.numLayers();
+		DeviceKvCache[] mirrors = new DeviceKvCache[layers];
+		CudaGraphSession[] graphs = new CudaGraphSession[layers];
+		try {
+			ResidentQkvPath path = handler.residentQkvPath();
+			assertThat(path).as("decode region active on " + model.getFileName()).isNotNull();
+			for (int li = 0; li < layers; li++)
+				assertThat(path.runsWholeLayer(li)).as("layer %d runs whole", li).isTrue();
+			Random rnd = new Random(5);
+			for (int li = 0; li < layers; li++)
+				mirrors[li] = mirrorWithHistory(cfg.kvDim(), pos, rnd);
+			float[] x0 = new float[cfg.hiddenDim()];
+			for (int i = 0; i < x0.length; i++)
+				x0[i] = rnd.nextFloat() * 2f - 1f;
+
+			try (ResidentQkvPath.Lease lease = path.lease()) {
+				float[][][] launched = token(path, mirrors, pos, x0, lease, null, true);
+				float[][][] replayed = token(path, mirrors, pos, x0, lease, graphs, true);
+				for (int li = 0; li < layers; li++)
+					for (int part = 0; part < 4; part++)
+						assertThat(replayed[li][part]).as("%s layer %d part %d", model.getFileName(), li, part)
+								.containsExactly(launched[li][part]);
+
+				for (int t = 0; t < warmup; t++) {
+					token(path, mirrors, pos, x0, lease, null, false);
+					token(path, mirrors, pos, x0, lease, graphs, false);
+				}
+				double[] launchedMs = new double[reps];
+				double[] replayedMs = new double[reps];
+				for (int rep = 0; rep < reps; rep++) {
+					// Alternate which lane goes first, so drift within a rep does not favour one.
+					boolean launchedFirst = rep % 2 == 0;
+					double a = block(path, mirrors, pos, x0, lease, launchedFirst ? null : graphs, tokens);
+					double b = block(path, mirrors, pos, x0, lease, launchedFirst ? graphs : null, tokens);
+					launchedMs[rep] = launchedFirst ? a : b;
+					replayedMs[rep] = launchedFirst ? b : a;
+				}
+				return new Row(model.getFileName().toString(), layers, pos, launchedMs, replayedMs);
+			}
+		} finally {
+			for (CudaGraphSession g : graphs)
+				if (g != null)
+					g.close();
+			for (DeviceKvCache m : mirrors)
+				if (m != null)
+					m.close();
+			handler.releaseGpuResources();
+			backend.releaseScratch();
+		}
+	}
+
+	/** Milliseconds per token over {@code tokens} tokens of one lane. */
+	private static double block(ResidentQkvPath path, DeviceKvCache[] mirrors, int pos, float[] x0,
+			ResidentQkvPath.Lease lease, CudaGraphSession[] graphs, int tokens) {
+		long t0 = System.nanoTime();
+		for (int t = 0; t < tokens; t++)
+			token(path, mirrors, pos, x0, lease, graphs, false);
+		return (System.nanoTime() - t0) / 1e6 / tokens;
+	}
+
+	/**
+	 * One token through every layer in {@code lease}: launched when {@code graphs} is
+	 * null, replayed otherwise. With {@code keep}, copies of each layer's k, v,
+	 * attention and output.
+	 */
+	private static float[][][] token(ResidentQkvPath path, DeviceKvCache[] mirrors, int pos, float[] x0,
+			ResidentQkvPath.Lease lease, CudaGraphSession[] graphs, boolean keep) {
+		float[][][] out = keep ? new float[mirrors.length][][] : null;
+		float[] x = x0;
+		for (int li = 0; li < mirrors.length; li++) {
+			ResidentQkvPath.Output got = graphs == null
+					? path.run(li, x, pos, mirrors[li], lease)
+					: path.runReplayed(li, x, pos, mirrors[li], lease, graphs);
+			if (keep)
+				out[li] = new float[][] { got.k.clone(), got.v.clone(), got.attn.clone(), got.layer.clone() };
+			x = got.layer;
+		}
+		return out;
+	}
+
+	private static DeviceKvCache mirrorWithHistory(int kvDim, int tokens, Random rnd) {
+		DeviceKvCache m = new DeviceKvCache(ctx, kvDim);
+		float[][] k = new float[tokens][kvDim];
+		float[][] v = new float[tokens][kvDim];
+		for (int t = 0; t < tokens; t++)
+			for (int i = 0; i < kvDim; i++) {
+				k[t][i] = rnd.nextFloat() * 2f - 1f;
+				v[t][i] = rnd.nextFloat() * 2f - 1f;
+			}
+		m.appendWindow(0, k, v, tokens);
+		m.ensureCapacity(tokens);
+		return m;
+	}
+
+	static double median(double[] xs) {
+		double[] s = xs.clone();
+		Arrays.sort(s);
+		int n = s.length;
+		return n % 2 == 1 ? s[n / 2] : (s[n / 2 - 1] + s[n / 2]) / 2;
+	}
+
+	private static double spreadPct(double[] xs) {
+		return (Arrays.stream(xs).max().orElse(0) - Arrays.stream(xs).min().orElse(0)) / median(xs) * 100;
+	}
+
+	private static String report(List<Row> rows, int tokens, int reps, int warmup) {
+		StringBuilder sb = new StringBuilder();
+		sb.append(String.format(Locale.ROOT,
+				"Decode layer graph replay: %d reps of %d tokens per lane, lanes alternated, %d warm-up tokens per lane%n%n",
+				reps, tokens, warmup));
+		sb.append("| Model | Layers | Pos | Launched ms/token (min-max, spread) | Replayed ms/token (min-max, spread)"
+				+ " | Saved ms/token | Saved us/layer | Replayed/launched | Parity |\n");
+		sb.append("|---|---|---|---|---|---|---|---|---|\n");
+		for (Row r : rows) {
+			double l = r.launched();
+			double g = r.replayed();
+			sb.append(String.format(Locale.ROOT,
+					"| %s | %d | %d | %.3f (%.3f-%.3f, %.1f%%) | %.3f (%.3f-%.3f, %.1f%%) | %.3f | %.1f | %.3f | bit-identical |%n",
+					r.model(), r.layers(), r.pos(), l, Arrays.stream(r.launchedMs()).min().orElse(0),
+					Arrays.stream(r.launchedMs()).max().orElse(0), spreadPct(r.launchedMs()), g,
+					Arrays.stream(r.replayedMs()).min().orElse(0), Arrays.stream(r.replayedMs()).max().orElse(0),
+					spreadPct(r.replayedMs()), l - g, (l - g) * 1000 / r.layers(), g / l));
+		}
+		sb.append("\nPer-rep readings (ms/token):\n");
+		for (Row r : rows)
+			sb.append(String.format(Locale.ROOT, "- %s launched %s replayed %s%n", r.model(),
+					Arrays.toString(r.launchedMs()), Arrays.toString(r.replayedMs())));
+		return sb.toString();
+	}
+}
